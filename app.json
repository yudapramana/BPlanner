{
  "expo": {
    "name": "Monthly Budget Planner",
    "slug": "budget-planner",
    "icon": "./assets/icon.png",
    "version": "1.16.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.yuda.budgetplanner",
      "allowBackup": false,
      "versionCode": 23,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "tagihan"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7FBF9"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "./plugins/withReleaseSigning",
      "./plugins/withLeanRelease"
    ]
  }
}