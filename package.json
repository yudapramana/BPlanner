{
  "name": "budget-planner",
  "version": "1.13.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "^58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-notifications": "^58.0.1",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.3.0",
    "sql.js": "^1.12.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/helpers/setup.js"
    ],
    "transform": {
      "\\.js$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/tests/helpers/expo-sqlite.js",
      "^react-native$": "<rootDir>/tests/helpers/react-native.js",
      "^expo-file-system$": "<rootDir>/tests/helpers/expo-file-system.js",
      "^expo-sharing$": "<rootDir>/tests/helpers/expo-sharing.js",
      "^expo-document-picker$": "<rootDir>/tests/helpers/expo-document-picker.js",
      "^xlsx$": "<rootDir>/tests/helpers/xlsx.js"
    }
  }
}
